# DevSolutionsHN - Environment Variables Example
# Copy this file to .env and fill in your values

# Formspree endpoint for contact form submissions
# Get yours at https://formspree.io/ and replace 'your-form-id'
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id

# Analytics (optional - for future use)
# VITE_GA_ID=G-XXXXXXXXXX
# VITE_UMAMI_ID=your-umami-id

# WhatsApp number (for future config-based approach)
# VITE_WHATSAPP_NUMBER=504XXXXXXXX